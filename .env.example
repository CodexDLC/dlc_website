# Project: dlc_montage
# Generated by codex-django

# Security
SECRET_KEY=replace-with-your-django-secret-key  # pragma: allowlist secret
DEBUG=True
# Required for encrypted model fields. Generate a Fernet key, for example:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-your-fernet-field-encryption-key  # pragma: allowlist secret

# Application
# Private storage (do not commit real credentials; switch to s3 only after verification)
PRIVATE_STORAGE_BACKEND=local
# Independent photo storage: documents retain PRIVATE_STORAGE_BACKEND=local.
# Set PHOTOS_STORAGE_BACKEND=s3 only with all PRIVATE_S3_* values configured.
PHOTOS_STORAGE_BACKEND=local
PRIVATE_S3_BUCKET=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_REGION=
PRIVATE_S3_ACCESS_KEY=
PRIVATE_S3_SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
SITE_BASE_URL=http://127.0.0.1:8000/

# Database
# DATABASE_URL=postgres://user:pass@localhost:5432/dlc_montage  # pragma: allowlist secret

# Test server overlay (deploy/compose.test-server.yml): set real values only in a private env file.
# Approved DLC hostname; DNS must point to the selected server before HTTPS deployment.
# TEST_SITE_BASE_URL=https://dlc.pinlite.dev/
# TEST_CANONICAL_DOMAIN=https://dlc.pinlite.dev
# ALLOWED_HOSTS=dlc.pinlite.dev
# CSRF_TRUSTED_ORIGINS=https://dlc.pinlite.dev
# PRIVATE_STORAGE_BACKEND=local
# For S3 photos, use PHOTOS_STORAGE_BACKEND=s3 and provide all PRIVATE_S3_* values above.
# Keep PRIVATE_STORAGE_BACKEND=local to preserve the existing document volume.
# Worker builds require an immutable release tag, normally the full commit SHA.
# DLC_IMAGE_TAG=<full-commit-sha>

# Dedicated morning digest; independent of Mailpit and application EMAIL_* settings.
# Copy all keys to the server's private /srv/dlc/shared/.env.prod before enabling the timer.
# No delivery without the password. Test mode delivers ONLY to primecodex@gmail.com.
CUSTOMER_DIGEST_MODE=test
CUSTOMER_DIGEST_ACTOR_ID=
CUSTOMER_DIGEST_RECIPIENT_USER_ID=
CUSTOMER_DIGEST_CLIENT_ID=
CUSTOMER_DIGEST_RECIPIENT_EMAIL=
CUSTOMER_DIGEST_FROM_EMAIL=primecodex@gmail.com
CUSTOMER_DIGEST_BASE_URL=https://dlc.pinlite.dev
CUSTOMER_DIGEST_SMTP_HOST=smtp.gmail.com
CUSTOMER_DIGEST_SMTP_PORT=587
CUSTOMER_DIGEST_SMTP_USER=primecodex@gmail.com
CUSTOMER_DIGEST_SMTP_PASSWORD=
CUSTOMER_DIGEST_SMTP_TIMEOUT=30
