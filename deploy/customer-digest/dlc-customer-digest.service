[Unit]
Description=DLC customer morning digest (one durable attempt)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/dlc/customer-digest/run.py --scheduled
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
