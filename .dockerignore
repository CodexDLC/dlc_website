# Git and VCS
archive/
.git/
.gitignore
.github/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment and package caches
.venv/
venv/
.uv-cache/
.pip-cache/

# Environment files and credentials
.env
.env.*
!.env.example

# Working databases and local persistent state
data/
*.sqlite3
*.db

# Temporary directories and runtime artifacts
.tmp/
tmp/
scratch/
logs/
outputs/
pdfs/
media/
staticfiles/

# Test, lint, and IDE caches
tests/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.idea/
.vscode/

# Deploy configs and docs (handled separately via mounts/contexts)
deploy/
!deploy/nginx/nginx.conf
docs/
